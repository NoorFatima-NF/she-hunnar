# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# -------------------------------------------------------------
# Safepay Sandbox Payment Gateway Configuration
# -------------------------------------------------------------
# Environment: sandbox (for testing) or production
SAFEPAY_ENV="sandbox"
VITE_SAFEPAY_ENV="sandbox"

# Safepay Public Key (Client-facing key from Sandbox Dashboard > Developer > API Keys)
VITE_SAFEPAY_PUBLIC_KEY="sec_your_sandbox_public_or_client_key_here"

# Safepay Secret Key (Server-only key from Sandbox Dashboard > Developer > API Keys)
# CRITICAL: Keep this secure on your server; never commit or expose in client code.
SAFEPAY_SECRET_KEY="sec_your_sandbox_secret_key_here"

# Safepay Webhook Secret (From Sandbox Dashboard > Webhooks)
SAFEPAY_WEBHOOK_SECRET="your_webhook_secret_here"

# -------------------------------------------------------------
# Supabase Realtime Database Configuration
# -------------------------------------------------------------
# Found in: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL="https://ltypflfpwqoehxqrftxa.supabase.co/rest/v1/"
